# Un solo .env para todos los temas. Copia este archivo a .env (en la raíz) y rellénalo.

# LangSmith: descarga de prompts + trazas de cada nodo
# LANGSMITH_PROJECT no va aquí: cada script usa el nombre de su tema por defecto.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# API key del proveedor del modelo configurado en el prompt (el modelo corre en tu máquina)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Identificadores de los prompts en LangSmith (opcional: "nombre:commit" fija la versión)

# --- prompt chaining/ ---
PROMPT_GENERAR=pc-generar    # variables: {topic}
PROMPT_MEJORAR=pc-mejorar    # variables: {texto}
PROMPT_PULIR=pc-pulir        # variables: {texto}

# --- routing/ ---  (atención al cliente de vehículos; los 4 reciben {input}: la consulta del cliente)
PROMPT_ROUTER=rt-router          # responde: reparacion | reclamo | producto
PROMPT_REPARACION=rt-reparacion
PROMPT_RECLAMO=rt-reclamo
PROMPT_PRODUCTO=rt-producto

# --- parallelization/ ---  (cotización de repuestos de vehículos; el gate y los 4 workers reciben {input}: la solicitud del cliente)
PROMPT_VALIDAR=par-validar                    # gate antes del fan-out (gemini-3.5-flash-lite): items, ciudad, nombre, vehículo
PROMPT_INVENTARIO=par-inventario              # stock y días de reposición (ERP simulado)
PROMPT_LOGISTICA=par-logistica                # costo y días de envío por courier
PROMPT_PRICING=par-pricing                    # precios, descuentos y margen mínimo
PROMPT_RECOMENDACIONES=par-recomendaciones    # opcional: up-selling / cross-selling
PROMPT_COTIZACION=par-cotizacion              # variables: {input} {inventario} {logistica} {pricing} {recomendaciones}
