# LangSmith: descarga de prompts + trazas de cada nodo
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=parallelization

# API key del proveedor del modelo configurado en el prompt (el modelo corre en tu máquina)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Identificadores de los prompts en LangSmith (opcional: "nombre:commit" fija la versión)
# Los 3 reciben la variable {input} (la reseña del cliente)
PROMPT_SENTIMIENTO=par-sentimiento
PROMPT_RESUMEN=par-resumen
PROMPT_TEMAS=par-temas
